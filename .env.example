# ============================================================================
# ARDS Python SDK & Server Configuration (.env.example)
# Copy to `.env` to customize local or cloud deployment settings.
# By default, ARDS runs 100% locally in a single process with SQLite (WAL+FTS5).
# ============================================================================

# --- 1. Project & Server Settings ---
ARDS_PROJECT_DIR=.
ARDS_HOST=127.0.0.1
ARDS_PORT=8000
ARDS_RELOAD=true

# --- 2. Storage & Search Backend (sqlite | bigquery | vertex | hybrid) ---
ARDS_BACKEND=sqlite
ARDS_SQLITE_PATH=ards_registry.db
ARDS_SEED_DEFAULTS=true

# --- 3. Ops Brain & Auto-Clean Settings ---
# Mode: combined (default: single process), frontend (serving only), worker (ops brain only)
ARDS_MODE=combined
ARDS_AUTO_CLEAN=false
ARDS_SWEEP_INTERVAL_SECONDS=60
ARDS_MAX_FAILURES=3
ARDS_PROTECT_SEED_DATA=true

# --- 4. Optional Production Pub/Sub (Disabled by default) ---
ARDS_PUBSUB_ENABLED=false
ARDS_PUBSUB_PROVIDER=memory        # memory (default) | sqlite | gcp
ARDS_PUBSUB_SQLITE_PATH=ards_events.db
ARDS_GCP_PUBSUB_TOPIC=ards-registrations
ARDS_GCP_PUBSUB_SUBSCRIPTION=ards-ops-brain-sub

# --- 5. Optional Google Cloud BigQuery & Vertex AI Search ---
GOOGLE_CLOUD_PROJECT=
ARDS_BQ_DATASET=ards_registry
ARDS_BQ_TABLE=resources
ARDS_BQ_AUDIT_TABLE=registrations_log
ARDS_BQ_CACHE_TTL_SECONDS=30
VERTEX_SEARCH_DATASTORE_ID=
VERTEX_SEARCH_LOCATION=global
